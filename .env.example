# Database (Supabase PostgreSQL pooler)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Payload CMS
PAYLOAD_SECRET=your-secure-random-secret-here

# Supabase Storage
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_STORAGE_ENABLED=true
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=shivamehndiart
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase S3-compatible storage
PAYLOAD_S3_ENABLED=true
PAYLOAD_S3_ENDPOINT=https://YOUR_PROJECT_REF.storage.supabase.co/storage/v1/s3
PAYLOAD_S3_BUCKET=shivamehndiart
PAYLOAD_S3_REGION=ap-northeast-1
PAYLOAD_S3_ACCESS_KEY_ID=your-s3-access-key
PAYLOAD_S3_SECRET_ACCESS_KEY=your-s3-secret-key

# Supabase publishable key (optional, for client SDK)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Resend (transactional emails)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Shiva Mehndi Art <onboarding@resend.dev>
RESEND_NOTIFY_EMAIL=bhumichanpura1234@gmail.com
